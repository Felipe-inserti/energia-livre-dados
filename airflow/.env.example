# Modelo do airflow/.env (que fica FORA do git). Gere o arquivo real, com as chaves aleatórias, com:
#   uv run python -m scripts.gerar_env_airflow
# e preencha DISCORD_WEBHOOK_URL (Discord: canal -> Editar canal -> Integrações -> Webhooks).
AIRFLOW_UID=1000
AIRFLOW__CORE__FERNET_KEY=gerado
AIRFLOW__API_AUTH__JWT_SECRET=gerado
AIRFLOW__API__SECRET_KEY=gerado
DISCORD_WEBHOOK_URL=
